<Application x:Class="Driveborn.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Palette: cold terminal dark, cyan for the Reader, amber for threat. -->
            <Color x:Key="VoidColor">#FF07090E</Color>
            <Color x:Key="PanelColor">#FF0E1219</Color>
            <Color x:Key="PanelEdgeColor">#FF1C2430</Color>
            <Color x:Key="InkColor">#FFD7E3F4</Color>
            <Color x:Key="MutedColor">#FF6E7F96</Color>
            <Color x:Key="CyanColor">#FF35E0D8</Color>
            <Color x:Key="AmberColor">#FFFFB454</Color>
            <Color x:Key="EmberColor">#FFFF5B5B</Color>
            <Color x:Key="VioletColor">#FFA07CFF</Color>

            <SolidColorBrush x:Key="Void" Color="{StaticResource VoidColor}"/>
            <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
            <SolidColorBrush x:Key="PanelEdge" Color="{StaticResource PanelEdgeColor}"/>
            <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}"/>
            <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/>
            <SolidColorBrush x:Key="Cyan" Color="{StaticResource CyanColor}"/>
            <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}"/>
            <SolidColorBrush x:Key="Ember" Color="{StaticResource EmberColor}"/>
            <SolidColorBrush x:Key="Violet" Color="{StaticResource VioletColor}"/>

            <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Panel}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="12"/>
            </Style>

            <Style x:Key="H1" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="Body" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="Background" Value="#FF161C26"/>
                <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Shell"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Shell" Property="Background" Value="#FF1E2734"/>
                                    <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Shell" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#FF10322F"/>
                <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
                <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
