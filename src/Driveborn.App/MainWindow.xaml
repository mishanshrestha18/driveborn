<Window x:Class="Driveborn.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Driveborn" Height="820" Width="1320"
        MinHeight="640" MinWidth="1060"
        Background="{StaticResource Void}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Focusable="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== header ===================================================== -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelEdge}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DRIVEBORN" FontFamily="{StaticResource Mono}" FontSize="16"
                               FontWeight="Bold" Foreground="{StaticResource Cyan}"/>
                    <TextBlock Text="your disk is the dungeon" Margin="12,0,0,0"
                               VerticalAlignment="Center" Style="{StaticResource Label}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderStreak" Style="{StaticResource Body}"
                               Foreground="{StaticResource Amber}" Margin="0,0,18,0"/>
                    <TextBlock x:Name="HeaderProfile" Style="{StaticResource Body}" Margin="0,0,18,0"/>
                    <Button x:Name="BtnHub" Content="Hub" Click="BtnHub_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== setup ====================================================== -->
        <Grid x:Name="SetupView" Grid.Row="1" Margin="0">
            <Border Style="{StaticResource Card}" MaxWidth="760" VerticalAlignment="Center" Padding="28">
                <StackPanel>
                    <TextBlock Text="Choose your territories" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0" Foreground="{StaticResource Muted}"
                               Text="Driveborn builds its dungeon out of folders you pick. Nothing else on this machine is ever read."/>

                    <Border Background="#FF0B1512" BorderBrush="#FF1E4B44" BorderThickness="1"
                            CornerRadius="3" Padding="12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="What this app does to your files: nothing."
                                       Style="{StaticResource Body}" Foreground="{StaticResource Cyan}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Label}" Margin="0,6,0,0"
                                       Text="Read-only by construction. It reads names, sizes and dates, plus the first line of small text files for flavour. It never writes, renames, moves or deletes anything. It has no network code at all. System folders, credential stores and key files are permanently excluded and cannot be added."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="TERRITORIES" Style="{StaticResource Label}" Margin="0,20,0,6"/>
                    <ListBox x:Name="TerritoryList" Height="180" Background="#FF0A0E14"
                             BorderBrush="{StaticResource PanelEdge}" Foreground="{StaticResource Ink}"
                             FontFamily="{StaticResource Mono}" FontSize="12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Add folder" Click="BtnAddTerritory_Click" Style="{StaticResource Primary}"/>
                        <Button Content="Remove selected" Click="BtnRemoveTerritory_Click" Margin="8,0,0,0"/>
                        <Button x:Name="BtnEnterWorld" Content="Enter the world"
                                Click="BtnEnterWorld_Click" Margin="8,0,0,0" Style="{StaticResource Primary}"/>
                    </StackPanel>

                    <TextBlock x:Name="SetupNote" Style="{StaticResource Label}" Margin="0,10,0,0"
                               Foreground="{StaticResource Ember}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== hub ======================================================== -->
        <Grid x:Name="HubView" Grid.Row="1" Visibility="Collapsed" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="RiftHeadline" Style="{StaticResource H1}"
                                   Foreground="{StaticResource Amber}" Text="Today's Rift"/>
                        <TextBlock x:Name="RiftDetail" Style="{StaticResource Body}" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="BtnEnterRift" Content="Descend into the Rift"
                                    Style="{StaticResource Primary}" Click="BtnEnterRift_Click"/>
                            <Button Content="Rescan" Margin="8,0,0,0" Click="BtnRescan_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="ENTRANCES" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                        <ListBox x:Name="EntranceList" Grid.Row="1" Background="Transparent"
                                 BorderThickness="0" Foreground="{StaticResource Ink}"
                                 FontFamily="{StaticResource Mono}" FontSize="12.5"
                                 MouseDoubleClick="EntranceList_MouseDoubleClick"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="THE READER" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="HubStats" Style="{StaticResource Body}" Margin="0,8,0,0"/>

                        <TextBlock Text="RECORDS" Style="{StaticResource Label}" Margin="0,18,0,0"/>
                        <TextBlock x:Name="HubRecords" Style="{StaticResource Body}" Margin="0,8,0,0"/>

                        <TextBlock Text="COLLECTION" Style="{StaticResource Label}" Margin="0,18,0,6"/>
                        <ListBox x:Name="CollectionList" Height="240" Background="#FF0A0E14"
                                 BorderBrush="{StaticResource PanelEdge}" Foreground="{StaticResource Ink}"
                                 FontFamily="{StaticResource Mono}" FontSize="11"/>

                        <Button Content="How to play" Margin="0,12,0,0" Click="BtnHowToPlay_Click"
                                Style="{StaticResource Primary}"/>
                        <Button Content="Manage territories" Margin="0,8,0,0" Click="BtnManage_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== descent ==================================================== -->
        <Grid x:Name="DescentView" Grid.Row="1" Visibility="Collapsed" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- HUD -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="INTEGRITY" Style="{StaticResource Label}"/>
                        <Grid Height="16" Margin="0,4,0,0">
                            <Border Background="#FF1A1015" CornerRadius="2"/>
                            <Border x:Name="IntegrityBar" Background="{StaticResource Ember}"
                                    HorizontalAlignment="Left" CornerRadius="2"/>
                            <TextBlock x:Name="IntegrityText" Style="{StaticResource Label}"
                                       Foreground="{StaticResource Ink}" HorizontalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="CYCLES" Style="{StaticResource Label}" Margin="0,14,0,0"/>
                        <StackPanel x:Name="CyclePips" Orientation="Horizontal" Margin="0,5,0,0"/>

                        <TextBlock Text="PARSERS" Style="{StaticResource Label}" Margin="0,16,0,0"/>
                        <StackPanel x:Name="ParserPanel" Margin="0,6,0,0"/>

                        <TextBlock Text="CACHE" Style="{StaticResource Label}" Margin="0,16,0,0"/>
                        <TextBlock x:Name="CacheText" Style="{StaticResource Body}" Margin="0,4,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="End turn" Click="BtnEndTurn_Click"/>
                            <Button x:Name="BtnExtract" Content="Extract" Margin="8,0,0,0"
                                    Style="{StaticResource Primary}" Click="BtnExtract_Click"/>
                        </StackPanel>
                        <Button Content="Abandon run" Margin="0,8,0,0" Click="BtnAbandon_Click"/>
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,16,0,0" Background="#FF090D12"
                            BorderBrush="{StaticResource PanelEdge}" BorderThickness="1" CornerRadius="3">
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="8">
                            <TextBlock x:Name="LogText" Style="{StaticResource Label}"
                                       Foreground="#FF9FB2C9" LineHeight="17"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- grid -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FF121824" Padding="12,9"
                            BorderBrush="{StaticResource PanelEdge}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock x:Name="RoomTitle" Style="{StaticResource Body}"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="RoomMeta" Style="{StaticResource Label}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Viewbox Grid.Row="1" Stretch="Uniform" Margin="10">
                        <Canvas x:Name="BoardCanvas" Background="Transparent"/>
                    </Viewbox>

                    <Border Grid.Row="2" Background="#FF0C111A" Padding="12,8"
                            BorderBrush="{StaticResource PanelEdge}" BorderThickness="0,1,0,0">
                        <TextBlock Style="{StaticResource Label}"
                                   Text="WASD / arrows move · 1-3 strike with that parser · E open cache · click a tile to target · Space end turn · X extract"/>
                    </Border>
                </Grid>
            </Border>

            <!-- inspector -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="INSPECTOR" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="InspectorText" Style="{StaticResource Body}" Margin="0,8,0,0"
                                   Text="Hover or select anything on the grid. The game always shows you the real file behind it."/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="DOORS" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <ListBox x:Name="DoorList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Ink}" FontFamily="{StaticResource Mono}"
                                 FontSize="11.5" MouseDoubleClick="DoorList_MouseDoubleClick"/>
                    </Grid>
                </Grid>
            </Border>
            <!-- guided first descent: floats over the board, never blocks it -->
            <Border x:Name="TutorialCard" Grid.Column="1" Visibility="Collapsed"
                    VerticalAlignment="Bottom" Margin="26,0,26,58"
                    Background="#F20E1B22" BorderBrush="{StaticResource Cyan}"
                    BorderThickness="1" CornerRadius="4" Padding="16,13">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="TutorialTitle" Style="{StaticResource Body}"
                                   FontWeight="Bold" Foreground="{StaticResource Cyan}"/>
                        <TextBlock x:Name="TutorialProgress" Style="{StaticResource Label}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock x:Name="TutorialBody" Style="{StaticResource Body}"
                               Margin="0,7,0,0" LineHeight="18"/>
                    <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                        <Button x:Name="BtnTutorialNext" Content="Next" Click="BtnTutorialNext_Click"
                                Style="{StaticResource Primary}"/>
                        <Button Content="Skip tutorial" Margin="8,0,0,0" Click="BtnTutorialSkip_Click"/>
                        <TextBlock x:Name="TutorialHint" Style="{StaticResource Label}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{StaticResource Amber}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== run summary overlay ======================================== -->
        <Grid x:Name="SummaryOverlay" Grid.Row="1" Visibility="Collapsed" Background="#CC05070B">
            <Border Style="{StaticResource Card}" MaxWidth="520" VerticalAlignment="Center" Padding="26">
                <StackPanel>
                    <TextBlock x:Name="SummaryTitle" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="SummaryBody" Style="{StaticResource Body}" Margin="0,12,0,0"/>
                    <Button Content="Return to hub" Margin="0,20,0,0" HorizontalAlignment="Left"
                            Style="{StaticResource Primary}" Click="BtnSummaryClose_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
